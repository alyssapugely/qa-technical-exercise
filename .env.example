# TMDB v4 read access token — the long JWT under
# themoviedb.org → Settings → API → "API Read Access Token".
# NOT the v3 API key: this is sent as an Authorization: Bearer header,
# never as a query parameter, so it stays out of URLs and server logs.
TMDB_READ_TOKEN=

# Matches docker-compose.yml. Port 5433 on purpose — 5432 is often already
# taken by a locally installed Postgres.
DATABASE_URL=postgresql://curator:curator@localhost:5433/curator

# Port the API listens on. The web dev server proxies /api here.
PORT=4000

# Optional overrides. Defaults are TMDB's own hosts and a five minute cache.
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# TMDB_CACHE_TTL_MS=300000
